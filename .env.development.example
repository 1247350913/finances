# Frontend auth mode
# legacy-supabase keeps current Supabase auth screens active.
# custom switches auth flows to server /api/auth endpoints.
VITE_AUTH_MODE=legacy-supabase

# Frontend -> backend API base (optional in dev with Vite proxy)
# VITE_API_BASE_URL=http://localhost:3001

# Neon Postgres connection (server)
DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

# Custom auth server settings
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_SECONDS=604800
AUTH_COOKIE_NAME=fin_auth
AUTH_COOKIE_SECURE=false

# Optional email delivery (Resend)
# RESEND_API_KEY=re_xxx
# RESEND_FROM=Finances <auth@yourdomain.com>

# Legacy Supabase values (temporary during migration)
# VITE_SUPABASE_URL=https://your-dev-project-id.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-dev-publishable-key
# SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key
