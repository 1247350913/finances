# Frontend auth mode
# legacy-supabase keeps current Supabase auth screens active.
# custom routes auth flows to the standalone auth-service (X-App-Id: finances).
VITE_AUTH_MODE=legacy-supabase

# auth-service base URL (frontend calls it directly, credentials: "include")
# Dev: the auth-service's dev Cloud Run URL (see auth-service README for the current one).
# VITE_AUTH_BASE_URL=https://auth-dev-46917854791.us-central1.run.app

# Frontend -> backend API base (optional in dev with Vite proxy)
# VITE_API_BASE_URL=http://localhost:3001

# Neon Postgres connection (server) — finances' own data only, no user/auth tables
DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

# Must match auth-service's JWT_SECRET and AUTH_COOKIE_NAME exactly — finances-api only
# verifies the token auth-service issues, it never signs its own.
JWT_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_NAME=auth_session

# Legacy Supabase values (temporary during migration)
# VITE_SUPABASE_URL=https://your-dev-project-id.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-dev-publishable-key
# SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key
