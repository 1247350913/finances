# Frontend auth mode
# Set to custom to route auth through the standalone auth-service.
VITE_AUTH_MODE=legacy-supabase

# auth-service base URL (frontend calls it directly, credentials: "include")
# VITE_AUTH_BASE_URL=https://auth.lnks.info

# Neon Postgres connection (server) — finances' own data only, no user/auth tables
DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

# Must match auth-service's JWT_SECRET and AUTH_COOKIE_NAME exactly — finances-api only
# verifies the token auth-service issues, it never signs its own. auth-service must also
# set AUTH_COOKIE_DOMAIN_FINANCES=.lnks.info so this cookie reaches api.finances.lnks.info.
JWT_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_NAME=auth_session

# Legacy Supabase environment variables (temporary during migration)
# VITE_SUPABASE_URL=https://your-prod-project-id.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-prod-publishable-key
# SUPABASE_SERVICE_ROLE_KEY=your-prod-service-role-key

# ── API base URL (frontend) ───────────────────────────────────────────────────
# Leave empty in dev — Vite proxies /api/* to localhost:3001 automatically.
# In production (Cloudflare Pages), set this to your Cloud Run backend URL:
#   VITE_API_BASE_URL=https://api.finances.lnks.info
VITE_API_BASE_URL=apiURL

# ── Server runtime ────────────────────────────────────────────────────────────
# PORT=3001
# NODE_ENV=development
# Comma-separated list of allowed CORS origins (leave unset in dev = allow all)
# ALLOWED_ORIGINS=https://finances.lnks.info